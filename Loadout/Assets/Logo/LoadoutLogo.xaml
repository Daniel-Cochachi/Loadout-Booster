<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- LOADOUT · Logo minimalista: tile noir + L carmesí + play hueso. Solo #0A0D16, #C50337, #FBF1EB. -->

  <ControlTemplate x:Key="LoadoutLogoMark">
    <Viewbox Stretch="Uniform">
      <Canvas Width="512" Height="512">
        <Rectangle Canvas.Left="48" Canvas.Top="48" Width="416" Height="416" RadiusX="104" RadiusY="104" Fill="#0A0D16" />
        <Rectangle Canvas.Left="176" Canvas.Top="148" Width="64" Height="216" RadiusX="16" RadiusY="16" Fill="#C50337" />
        <Rectangle Canvas.Left="176" Canvas.Top="300" Width="160" Height="64" RadiusX="16" RadiusY="16" Fill="#C50337" />
        <Path Fill="#FBF1EB" Data="M262 214 L262 310 L340 262 Z" />
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <DrawingImage x:Key="LoadoutLogoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0A0D16">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="48,48,416,416" RadiusX="104" RadiusY="104" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#C50337">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="176,148,64,216" RadiusX="16" RadiusY="16" />
              <RectangleGeometry Rect="176,300,160,64" RadiusX="16" RadiusY="16" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FBF1EB">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M262 214 L262 310 L340 262 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

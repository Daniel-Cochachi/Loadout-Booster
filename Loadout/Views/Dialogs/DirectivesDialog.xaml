<ui:FluentWindow x:Class="Loadout.Views.Dialogs.DirectivesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LOADOUT · Directivas ranked" Height="560" Width="520"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    Background="{StaticResource CabBg}" Foreground="{StaticResource CabText}"
    FontFamily="{StaticResource CabUi}">
    <Border Background="{StaticResource CabSurface}" BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="16" Margin="14">
        <StackPanel Margin="20,48,20,16">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="DIRECTIVAS" FontFamily="{StaticResource PopBlack}" FontSize="20" Foreground="{StaticResource CabText}" />
                <TextBlock Text="Reglas rápidas del perfil" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabTextMut}" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Text="UNA DIRECTIVA POR LÍNEA · EL PRIMER CARÁCTER DEFINE EL COLOR"
                FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold"
                Foreground="{StaticResource CabAmber}" TextWrapping="Wrap" />
            <TextBlock FontFamily="{StaticResource CabMono}" FontSize="11"
                Foreground="{StaticResource CabTextMut}" Margin="0,8,0,0" TextWrapping="Wrap">
                <Run Text="! " Foreground="#FF4D6E" FontWeight="Bold" /><Run Text="crítico   " />
                <Run Text="# " Foreground="#E8A2B2" FontWeight="Bold" /><Run Text="prioridad   " />
                <Run Text="▲ " Foreground="#E7547A" FontWeight="Bold" /><Run Text="aviso   " />
                <Run Text="/ " Foreground="#9A8B90" FontWeight="Bold" /><Run Text="nota" />
            </TextBlock>
            <TextBox x:Name="LinesBox" Margin="0,12,0,0" Height="250" Padding="10,8"
                AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                FontSize="13" Background="{StaticResource CabSurface}" Foreground="{StaticResource CabText}"
                BorderBrush="{StaticResource CabHairline}" BorderThickness="1" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="CANCELAR" Style="{StaticResource ArcadeGhostBtn}" Padding="13,7" FontSize="13" Click="Cancel_Click" />
                <Button Content="■ GUARDAR" Style="{StaticResource ArcadePlayBtn}" FontSize="13"
                        Padding="15,8" Margin="8,0,0,0" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>

<ui:FluentWindow x:Class="Loadout.Views.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LOADOUT · Ajustes" Height="730" Width="500"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    Background="{StaticResource CabBg}" Foreground="{StaticResource CabText}"
    FontFamily="{StaticResource CabUi}">
    <Border Background="{StaticResource CabSurface}" BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="16" Margin="14">
        <ScrollViewer Margin="20,44,20,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="AJUSTES" FontFamily="{StaticResource PopBlack}" FontSize="20" Foreground="{StaticResource CabText}" />
                <TextBlock Text="Organiza el flujo del lanzador y optimizaciones" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabTextMut}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- AUTOMATIZACIÓN & JUEGOS -->
            <TextBlock Text="AUTOMATIZACIÓN &amp; GUARDIÁN" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" />
            <CheckBox x:Name="AutoDetectBox" Content="Auto-detectar juegos (Modo Guardián Silencioso)" Margin="0,8,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />
            <TextBlock Text="Detecta Valorant, LoL o tus perfiles abiertos desde Riot Client o Steam y activa el Boost automáticamente."
                       FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextDim}" TextWrapping="Wrap" Margin="24,2,0,0" />

            <CheckBox x:Name="AlwaysDndBox" Content="Modo 'No Molestar' (Silenciar avisos y notificaciones al jugar)" Margin="0,10,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />
            <TextBlock Text="Bloquea ventanas emergentes, avisos de Windows y correos mientras estás en partida."
                       FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextDim}" TextWrapping="Wrap" Margin="24,2,0,0" />

            <CheckBox x:Name="DndBox" Content="No Molestar estricto en Modo Ranked" Margin="0,10,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />

            <!-- LATENCIA DE RED -->
            <TextBlock Text="LATENCIA DE RED (TCP NODELAY / ANTI-NAGLE)" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,18,0,0" />
            <Border Background="{StaticResource CabSurface2}" BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="TcpStatusText" Text="Estado TCP: Comprobando..." FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabText}" />
                    <TextBlock Text="Elimina el búfer de paquetes pequeños de Windows para respuesta inmediata en juegos online." FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextDim}" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyTcpBtn" Content="⚡ APLICAR TCP NODELAY" Style="{StaticResource ArcadePlayBtn}" Padding="10,5" FontSize="11" Click="ApplyTcp_Click" />
                        <Button x:Name="RevertTcpBtn" Content="REVERTIR A ESTÁNDAR" Style="{StaticResource ArcadeGhostBtn}" Padding="10,5" FontSize="11" Margin="8,0,0,0" Click="RevertTcp_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TcpFeedbackText" FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabAmber}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- DASHBOARD EN JUEGO (HUD) -->
            <TextBlock Text="DASHBOARD EN JUEGO (HUD)" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,18,0,0" />
            <CheckBox x:Name="DashboardEnabledBox" Content="Habilitar Dashboard en partida (0% lag bajo demanda)" Margin="0,8,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />
            <TextBlock Text="Atajo global para abrir/ocultar en juego:" FontFamily="{StaticResource CabMono}" FontSize="10"
                Foreground="{StaticResource CabTextMut}" Margin="0,8,0,2" />
            <ComboBox x:Name="DashboardHotkeyCombo" Margin="0,2,0,0" Height="32"
                      Foreground="{StaticResource CabText}" Background="{StaticResource CabSurface2}">
                <ComboBoxItem Content="Ctrl + F11 (Recomendado)" IsSelected="True" />
                <ComboBoxItem Content="Ctrl + F10" />
                <ComboBoxItem Content="Ctrl + F12" />
                <ComboBoxItem Content="Alt + D" />
                <ComboBoxItem Content="Ctrl + Shift + D" />
            </ComboBox>

            <!-- SISTEMA -->
            <TextBlock Text="SISTEMA" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,18,0,0" />
            <CheckBox x:Name="AutoBox" Content="Iniciar con Windows" Margin="0,8,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />
            <CheckBox x:Name="TrayBox" Content="La X minimiza a la bandeja (sigue en 2.º plano)" Margin="0,8,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />
            <CheckBox x:Name="HotBox" Content="Hotkey global Ctrl+Alt+L (abrir ventana)" Margin="0,8,0,0"
                Foreground="{StaticResource CabText}" FontSize="13" />

            <!-- BASE DE DATOS -->
            <TextBlock Text="BASE DE DATOS" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,18,0,0" />
            <TextBlock x:Name="DbPathText" FontFamily="{StaticResource CabMono}" FontSize="10"
                Foreground="{StaticResource CabTextMut}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="ABRIR CARPETA" Style="{StaticResource ArcadeGhostBtn}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5"
                    Click="OpenDbFolder_Click" />

            <!-- ACTUALIZACIONES -->
            <TextBlock Text="ACTUALIZACIONES" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,18,0,0" />
            <TextBlock x:Name="UpdateStatusText" FontFamily="{StaticResource CabMono}" FontSize="10"
                Foreground="{StaticResource CabTextMut}" TextWrapping="Wrap" Margin="0,8,0,0"
                Text="Haz clic para buscar nuevas versiones." />
            <Button x:Name="UpdateBtn" Content="⟳ BUSCAR ACTUALIZACIONES" Style="{StaticResource ArcadeGhostBtn}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5"
                    Click="CheckUpdate_Click" />

            <!-- INFORMACIÓN -->
            <TextBlock Text="INFORMACIÓN" FontFamily="{StaticResource CabMono}" FontSize="11"
                FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,18,0,0" />
            <TextBlock x:Name="VersionText" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold"
                Foreground="{StaticResource CabTextDim}" Margin="0,8,0,0" Text="v—" />

            <!-- BOTONES ACCIÓN -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCELAR" Style="{StaticResource ArcadeGhostBtn}" Padding="13,7" FontSize="13" Click="Cancel_Click" />
                <Button Content="■ GUARDAR" Style="{StaticResource ArcadePlayBtn}" FontSize="13"
                        Padding="15,8" Margin="8,0,0,0" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</ui:FluentWindow>

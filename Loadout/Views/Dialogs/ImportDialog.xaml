<ui:FluentWindow x:Class="Loadout.Views.Dialogs.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LOADOUT · Importar accesos" Height="620" Width="640"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    Background="{StaticResource CabBg}" Foreground="{StaticResource CabText}"
    FontFamily="{StaticResource CabUi}">
    <Border Background="{StaticResource CabSurface}" BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="16" Margin="14">
        <Grid Margin="20,48,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="IMPORTAR ACCESOS" FontFamily="{StaticResource PopBlack}" FontSize="20" Foreground="{StaticResource CabText}" />
                <TextBlock Text="Escoge accesos de inicio y escritorio" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabTextMut}" Margin="0,3,0,0" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Escaneando escritorio + menú inicio…"
                FontFamily="{StaticResource CabMono}" FontSize="12" FontWeight="Bold"
                Foreground="{StaticResource CabAmber}" />
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" Padding="10,7" FontSize="13"
                    Background="{StaticResource CabSurface}" Foreground="{StaticResource CabText}"
                    BorderBrush="{StaticResource CabHairline}" BorderThickness="1"
                    TextChanged="Filter_Changed" />
                <Button Grid.Column="1" Content="SELECCIONAR TODOS" Style="{StaticResource ArcadeGhostBtn}"
                        Margin="8,0,0,0" Padding="10,5" Click="SelectAll_Click" />
                <Button Grid.Column="2" Content="LIMPIAR" Style="{StaticResource ArcadeGhostBtn}"
                        Margin="6,0,0,0" Padding="10,5" Click="SelectNone_Click" />
            </Grid>

            <ListBox x:Name="ResultList" Grid.Row="3" Margin="0,10,0,0"
                     Background="Transparent" BorderBrush="{StaticResource CabHairline}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" Padding="10,7"
                                            BorderBrush="{StaticResource CabHairline}" BorderThickness="0,0,0,1">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Foreground="{StaticResource CabText}"
                                                  VerticalContentAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Entry.Name}" FontSize="13"
                                                    FontWeight="SemiBold" Foreground="{StaticResource CabText}" />
                                                <TextBlock FontFamily="{StaticResource CabMono}" FontSize="10"
                                                    Foreground="{StaticResource CabTextMut}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Entry.Kind, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Entry.Target, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" FontFamily="{StaticResource CabMono}" FontSize="11"
                    Foreground="{StaticResource CabTextMut}" VerticalAlignment="Center" Text="0 ACCESOS SELECCIONADOS" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="CANCELAR" Style="{StaticResource ArcadeGhostBtn}" Padding="13,7" FontSize="13" Click="Cancel_Click" />
                    <Button Content="■ IMPORTAR" Style="{StaticResource ArcadePlayBtn}" FontSize="13"
                            Padding="15,8" Margin="8,0,0,0" Click="Import_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>

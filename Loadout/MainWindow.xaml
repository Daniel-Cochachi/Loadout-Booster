<ui:FluentWindow x:Class="Loadout.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    Title="LOADOUT" Height="900" Width="1440"
    Icon="Assets/Logo/loadout-logo.png"
    MinHeight="800" MinWidth="1280"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Default"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    FontFamily="{StaticResource CabUi}"
    Background="{StaticResource CabAppGradient}"
    Foreground="{StaticResource CabText}"
    Loaded="Window_Loaded">

    <Grid Background="{StaticResource CabAppGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="{StaticResource CabSurface}" Opacity="0.55" />

        <!-- Glows ambientales -->
        <Ellipse Grid.RowSpan="3" Width="760" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-180,-220,0" IsHitTestVisible="False" Opacity="0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#3DC50337" />
                    <GradientStop Offset="1" Color="#00C50337" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.RowSpan="3" Width="620" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-200,0,0,-160" IsHitTestVisible="False" Opacity="0.4">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#2E7A0226" />
                    <GradientStop Offset="1" Color="#007A0226" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ui:TitleBar Grid.RowSpan="3" Title="" Icon="{x:Null}"
            Background="Transparent" Foreground="#FFFFFF" ButtonsForeground="#FFFFFF"
            Panel.ZIndex="999" VerticalAlignment="Top" Height="44" />

        <tb:TaskbarIcon x:Name="Tray" ToolTipText="Loadout"
            IconSource="Assets/Logo/loadout-logo-32.png"
            TrayMouseDoubleClick="Tray_Open" TrayLeftMouseDown="Tray_Toggle">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir Loadout" FontWeight="Bold" Click="Tray_Open" />
                    <MenuItem Header="Jugar favorito" Click="Tray_PlayFav" />
                    <MenuItem Header="⚡ Liberar RAM" Click="Tray_Boost" />
                    <Separator />
                    <MenuItem Header="Salir" Click="Tray_Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0" Margin="28,54,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="11" Padding="0"
                        BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                    <Image Source="Assets/Logo/loadout-logo-64.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="LOADOUT" FontFamily="{StaticResource PopBlack}" FontSize="30"
                    Foreground="{StaticResource CabText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                <Border BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="10"
                        Padding="14,8" Margin="8,0,0,0">
                    <TextBlock Text="{Binding AppRamText}" FontFamily="{StaticResource CabMono}"
                        FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabAmber}" />
                </Border>
                <Border BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="10"
                        Padding="14,8" Margin="8,0,0,0">
                    <TextBlock Text="{Binding TrayLabel}" FontFamily="{StaticResource CabMono}"
                        FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabTextDim}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚡ BOOST" Style="{StaticResource ArcadePlayBtn}"
                        Click="Boost_Click" Padding="15,9" FontSize="12" />
                <Button Content="⚙ AYUDA" Style="{StaticResource ArcadeGhostBtn}"
                        Click="Diagnostics_Click" Padding="15,9" Margin="4,0,0,0" />
                <Button Content="AJUSTES" Style="{StaticResource ArcadeGhostBtn}"
                        Click="Settings_Click" Padding="15,9" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ================= DASHBOARD · 3 COLUMNAS ================= -->
        <Grid Grid.Row="1" Margin="28,20,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ── RAIL IZQ · PERFILES ── -->
            <Border Grid.Column="0" Background="{StaticResource CabSurface}"
                    BorderBrush="{StaticResource CabHairline}" BorderThickness="1"
                    CornerRadius="16" Padding="14,14,10,14" Margin="0,0,14,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="11" Height="11" Fill="{StaticResource CabGold}" VerticalAlignment="Center" />
                            <TextBlock Text="PERFILES" FontFamily="{StaticResource PopBlack}" FontSize="19"
                                Foreground="{StaticResource CabText}" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource CabCrimson}" CornerRadius="8" Padding="12,5"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loadouts.Count, StringFormat={}{0:00}}" FontFamily="{StaticResource CabMono}"
                                FontSize="12" FontWeight="Bold" Foreground="{StaticResource CabGold}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,14,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FavBtn" Content="☆" FontSize="22"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{StaticResource CabAmber}" Padding="8,2" VerticalAlignment="Center"
                                Click="Fav_Click" ToolTip="Favorito: bandeja + hotkey juegan este" />
                            <Button Grid.Column="1" Content="+ NUEVO" Style="{StaticResource ArcadePlayBtn}"
                                    Click="NewLoadout_Click" Padding="11,9" FontSize="12" Margin="6,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="EDITAR" Style="{StaticResource ArcadePlayBtn}" Click="EditLoadout_Click" Padding="7,6" FontSize="11" />
                            <Button Grid.Column="1" Content="BORRAR" Style="{StaticResource ArcadePlayBtn}" Click="DeleteLoadout_Click"
                                    Padding="7,6" FontSize="11" Margin="6,0,0,0" />
                            <Button Grid.Column="2" Content="‹" Style="{StaticResource ArcadeGhostBtn}" Click="ScrollLeft_Click" Padding="8,6" FontSize="14" Margin="6,0,0,0" />
                            <Button Grid.Column="3" Content="›" Style="{StaticResource ArcadeGhostBtn}" Click="ScrollRight_Click" Padding="8,6" FontSize="14" Margin="4,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="⮬ EXPORTAR" Style="{StaticResource ArcadeGhostBtn}" Click="ExportLoadout_Click" Padding="6,6" FontSize="11" ToolTip="Guardar el perfil actual como backup JSON" />
                            <Button Grid.Column="1" Content="⮮ IMPORTAR" Style="{StaticResource ArcadeGhostBtn}" Click="ImportLoadout_Click" Padding="6,6" FontSize="11" Margin="6,0,0,0" ToolTip="Restaurar perfiles desde un backup JSON" />
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="PosterList" Grid.Row="2"
                             ItemsSource="{Binding Loadouts}"
                             SelectedItem="{Binding SelectedLoadout}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,16,6,10" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ControlTemplate.Resources>
                                                <DropShadowEffect x:Key="CardIdle" Color="#000000" BlurRadius="18" ShadowDepth="6" Opacity="0.5" />
                                                <DropShadowEffect x:Key="CardHover" Color="#C50337" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
                                                <DropShadowEffect x:Key="CardSel" Color="#C50337" BlurRadius="22" ShadowDepth="4" Opacity="0.8" />
                                            </ControlTemplate.Resources>
                                            <!-- Tarjeta 3D: tile de color + arte que desborda -->
                                            <Border x:Name="Chip" Background="{Binding CardBrush}"
                                                    BorderBrush="Transparent" BorderThickness="0"
                                                    CornerRadius="24" Padding="0">
                                                <Border.Effect>
                                                    <StaticResource ResourceKey="CardIdle" />
                                                </Border.Effect>
                                                <Grid Height="148">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="128" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Texto abajo-izquierda -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="16,0,0,14">
                                                        <Border Background="#66000000" CornerRadius="7" Padding="8,3"
                                                                HorizontalAlignment="Left" Margin="0,0,0,7">
                                                            <TextBlock Text="{Binding BayShort}" FontFamily="{StaticResource CabMono}"
                                                                FontSize="10" FontWeight="Bold"
                                                                Foreground="#FBF1EB" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PopBlack}" FontSize="17"
                                                            Foreground="{Binding ColorHex, Converter={StaticResource HexContrastConv}}"
                                                            TextWrapping="Wrap" MaxHeight="48" LineHeight="22" />
                                                        <TextBlock FontFamily="{StaticResource CabMono}" FontSize="9" FontWeight="Bold"
                                                            Foreground="{Binding ColorHex, Converter={StaticResource HexContrastConv}}"
                                                            Opacity="0.8" Margin="0,4,0,0">
                                                            <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" SLOTS" /><Run Text=" · " /><Run Text="{Binding Tag, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <!-- Punto EN JUEGO -->
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FBF1EB"
                                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                                             Margin="16,12,0,0"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#FFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- Arte 3D desbordante -->
                                                    <Grid Grid.Column="1" Margin="0,-18,-8,-8" Panel.ZIndex="5">
                                                        <Image Source="{Binding CoverPath, Converter={StaticResource CoverImgConv}}"
                                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               MaxWidth="150" MaxHeight="150"
                                                               Visibility="{Binding HasCover, Converter={StaticResource BoolVis}}">
                                                            <Image.RenderTransform>
                                                                <RotateTransform Angle="-8" />
                                                            </Image.RenderTransform>
                                                            <Image.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="7" Opacity="0.55" />
                                                            </Image.Effect>
                                                        </Image>
                                                        <!-- Monograma 3D si no hay portada -->
                                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                              Visibility="{Binding HasNoCover, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{Binding CoverInitials}" FontFamily="{StaticResource PopBlack}" FontSize="64"
                                                                Foreground="#66000000" Margin="3,4,0,0"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CoverInitials}" FontFamily="{StaticResource PopBlack}" FontSize="64"
                                                                Foreground="{Binding ColorHex, Converter={StaticResource HexContrastConv}}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Effect" Value="{StaticResource CardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#FBF1EB" />
                                                    <Setter TargetName="Chip" Property="BorderThickness" Value="2.5" />
                                                    <Setter TargetName="Chip" Property="Effect" Value="{StaticResource CardSel}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── CENTRO · HERO + ACCESOS ── -->
            <Grid Grid.Column="1" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero banner del perfil -->
                <Border CornerRadius="18" Padding="22,16,22,16"
                        Background="{Binding SelectedLoadout.CardBrush, FallbackValue={StaticResource CabSurface2}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.5" />
                    </Border.Effect>
                    <Grid Visibility="{Binding Loadouts.Count, Converter={StaticResource NotZeroVisConv}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="12,5">
                                    <TextBlock Text="{Binding SelectedLoadout.BayShort}" FontFamily="{StaticResource CabMono}"
                                        FontSize="11" FontWeight="Bold" Foreground="#1C1C1E" />
                                </Border>
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="12,5" Margin="8,0,0,0"
                                        Visibility="{Binding SelectedLoadout.IsActive, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="● EN JUEGO" FontFamily="{StaticResource CabMono}" FontSize="9"
                                        FontWeight="Bold" Foreground="{StaticResource CabCrimson}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedLoadoutName}" FontFamily="{StaticResource PopBlack}" FontSize="34"
                                Foreground="{Binding SelectedLoadout.ColorHex, Converter={StaticResource HexContrastConv}}"
                                Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedLoadoutTag}" FontFamily="{StaticResource CabMono}" FontSize="12"
                                FontWeight="Bold" Foreground="{Binding SelectedLoadout.ColorHex, Converter={StaticResource HexContrastConv}}"
                                Opacity="0.85" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedLoadout.NotesPreview, FallbackValue={x:Null}}" FontFamily="{StaticResource CabUi}"
                                FontSize="12" Foreground="{Binding SelectedLoadout.ColorHex, Converter={StaticResource HexContrastConv}}"
                                TextWrapping="Wrap" MaxWidth="540" Opacity="0.75" Margin="0,8,0,0"
                                Visibility="{Binding SelectedLoadout.HasNotes, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                        <!-- Arte 3D de la portada, desbordando el banner -->
                        <Grid Grid.Column="1" Margin="6,-28,-6,-24" Panel.ZIndex="5"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="{Binding SelectedLoadout.CoverPath, Converter={StaticResource CoverImgConv}}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   MaxWidth="180" MaxHeight="150"
                                   Visibility="{Binding SelectedLoadout.HasCover, Converter={StaticResource BoolVis}}">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="-8" />
                                </Image.RenderTransform>
                                <Image.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="9" Opacity="0.6" />
                                </Image.Effect>
                            </Image>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding SelectedLoadout.HasNoCover, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding SelectedLoadout.CoverInitials}" FontFamily="{StaticResource PopBlack}" FontSize="72"
                                    Foreground="#66000000" Margin="3,4,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedLoadout.CoverInitials}" FontFamily="{StaticResource PopBlack}" FontSize="72"
                                    Foreground="{Binding SelectedLoadout.ColorHex, Converter={StaticResource HexContrastConv}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <Button Grid.Column="2" Content="▶  JUGAR" Style="{StaticResource ArcadePlayBtn}"
                                Command="{Binding PlayCommand}" FontSize="25" Padding="38,22"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0" />
                    </Grid>
                </Border>

                <!-- Overlay sin perfiles -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding Loadouts.Count, Converter={StaticResource ZeroToVisConv}}">
                    <TextBlock Text="⌬" FontFamily="{StaticResource PopBlack}" FontSize="46"
                               Foreground="{StaticResource CabGold}" HorizontalAlignment="Center" />
                    <TextBlock Text="AÚN NO HAY PERFILES" FontFamily="{StaticResource PopBlack}" FontSize="24"
                               Foreground="{StaticResource CabText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Crea el tuyo con  + NUEVO" FontFamily="{StaticResource CabUi}" FontSize="14"
                               Foreground="{StaticResource CabTextDim}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Cabecera de accesos -->
                <Grid Grid.Row="1" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACCESOS" FontFamily="{StaticResource PopBlack}" FontSize="20"
                            Foreground="{StaticResource CabText}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource CabSurface}" BorderBrush="{StaticResource CabHairline}" BorderThickness="1"
                                CornerRadius="8" Padding="11,5" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Slots.Count, StringFormat={}{0:00}}" FontFamily="{StaticResource CabMono}"
                                FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabAmber}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ AGREGAR" Style="{StaticResource ArcadePlayBtn}" Click="AddItem_Click" Padding="11,7" FontSize="12" />
                        <Button Content="▶ ACTIVO" Style="{StaticResource ArcadeGhostBtn}" Click="Running_Click" Padding="11,7" FontSize="12" Margin="6,0,0,0" ToolTip="Agregar desde juegos en ejecución" />
                        <Button Content="STEAM" Style="{StaticResource ArcadeGhostBtn}" Click="Steam_Click" Padding="11,7" FontSize="12" Margin="6,0,0,0" ToolTip="Importar desde librería Steam" />
                        <Button Content="⤓ IMPORTAR" Style="{StaticResource ArcadePlayBtn}" Click="Import_Click" Padding="11,7" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Grid de tarjetas de accesos (acepta arrastre de .exe) -->
                <Grid Grid.Row="2" AllowDrop="True" Drop="Slots_Drop" DragOver="Slots_DragOver">
                    <ListBox ItemsSource="{Binding Slots}"
                             SelectedItem="{Binding SelectedSlot}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ControlTemplate.Resources>
                                                <DropShadowEffect x:Key="CardHoverFx" Color="#C50337" BlurRadius="16" ShadowDepth="3" Opacity="0.55" />
                                            </ControlTemplate.Resources>
                                            <Border x:Name="Card" Width="310" Background="{StaticResource CabSurface}"
                                                    BorderBrush="{StaticResource CabHairline}"
                                                    BorderThickness="1" CornerRadius="14" Padding="13,10">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="48" Height="48"
                                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border CornerRadius="13" Background="#0A0D16"
                                                                    BorderBrush="{StaticResource CabHairline}" BorderThickness="1">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.5" />
                                                                </Border.Effect>
                                                                <Grid Margin="6">
                                                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" />
                                                                    <TextBlock Text="{Binding SlotNumber}" FontFamily="{StaticResource PopXBold}"
                                                                        FontSize="13" Foreground="{StaticResource CabAmber}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasNoIcon, Converter={StaticResource BoolVis}}" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Width="21" Height="15" CornerRadius="7" Background="#CC02060E"
                                                                    BorderBrush="{StaticResource CabHairline}" BorderThickness="1"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-4">
                                                                <TextBlock Text="{Binding SlotNumber}" FontFamily="{StaticResource CabMono}"
                                                                    FontSize="8" FontWeight="Bold" Foreground="{StaticResource CabText}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource CabLedOff}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Exe">
                                                                                    <Setter Property="Background" Value="{StaticResource CabAmber}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Url">
                                                                                    <Setter Property="Background" Value="{StaticResource CabOrange}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Steam">
                                                                                    <Setter Property="Background" Value="{StaticResource CabBlue}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Kind}" FontFamily="{StaticResource CabMono}"
                                                                        FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                </Border>
                                                                <Ellipse x:Name="Led" Width="9" Height="9" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                         Fill="{Binding State, Converter={StaticResource SlotLedConv}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PopBold}" FontSize="14"
                                                                Foreground="{StaticResource CabText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Cursor="Hand" Padding="10,6" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.ToggleSlotEnabledCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Armar / desarmar slot (desarmado se salta al lanzar)">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="{StaticResource CabCrimson}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource CabText}" />
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="1" CornerRadius="8"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="Foreground" Value="{StaticResource CabTextMut}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource CabHairline}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="{Binding ArmedLabel, StringFormat='{}{0} ✓'}" FontFamily="{StaticResource CabUi}" FontSize="11" FontWeight="Bold" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Target}" FontFamily="{StaticResource CabMono}"
                                                        FontSize="10" Foreground="{StaticResource CabTextMut}" Margin="0,7,0,0"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Text="{Binding DelayLabel}" FontFamily="{StaticResource CabMono}"
                                                        FontSize="10" FontWeight="Bold" Foreground="{StaticResource CabAmber}" Margin="0,5,0,0" />
                                                    <Button Grid.Row="3" Margin="0,7,0,0" Padding="10,5" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.ToggleSlotPriorityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Solo este acceso recibe CPU High (incluye su partida hija, ej. League of Legends.exe). Si ninguno está marcado, se priorizan todos.">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Foreground" Value="{StaticResource CabTextMut}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource CabHairline}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="1" CornerRadius="8"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HighPriority}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource CabAmber}" />
                                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding PriorityLabel}" FontFamily="{StaticResource CabMono}" FontSize="10" FontWeight="Bold" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CabAmber}" />
                                                    <Setter TargetName="Card" Property="Effect" Value="{StaticResource CardHoverFx}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CabAmber}" />
                                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.72" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Led"
                                                                    Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                    From="1" To="0.35" Duration="0:0:0.6"
                                                                    AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Slots.Count, Converter={StaticResource ZeroToVisConv}}">
                        <TextBlock Text="⬡" FontFamily="{StaticResource PopBlack}" FontSize="34"
                                   Foreground="{StaticResource CabGold}" HorizontalAlignment="Center" />
                        <TextBlock Text="ESTE PERFIL NO TIENE ACCESOS" FontFamily="{StaticResource PopBlack}" FontSize="18"
                                   Foreground="{StaticResource CabTextMut}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="Agrega uno con  + AGREGAR , arrastra .exe aquí  o importa de tu equipo con  ⤓ IMPORTAR" FontFamily="{StaticResource CabUi}" FontSize="13"
                                   Foreground="{StaticResource CabText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Orden de accesos -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Content="EDITAR" Style="{StaticResource ArcadePlayBtn}" Click="EditItem_Click" Padding="13,7" FontSize="12" />
                    <Button Content="▲" Style="{StaticResource ArcadeGhostBtn}" Click="MoveUp_Click" Padding="13,7" Margin="6,0,0,0" ToolTip="Subir orden" />
                    <Button Content="▼" Style="{StaticResource ArcadeGhostBtn}" Click="MoveDown_Click" Padding="13,7" Margin="6,0,0,0" ToolTip="Bajar orden" />
                    <Button Content="QUITAR" Style="{StaticResource ArcadePlayBtn}" Click="DeleteItem_Click" Padding="13,7" FontSize="12" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ── DERECHA · SESIÓN ── -->
            <Border Grid.Column="2" Background="{StaticResource CabSurface}"
                    BorderBrush="{StaticResource CabHairline}" BorderThickness="1"
                    CornerRadius="16" Padding="24,20,24,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="11" Height="11" Fill="{StaticResource CabCrimson}" VerticalAlignment="Center" />
                        <TextBlock Text="SESIÓN" FontFamily="{StaticResource PopBlack}" FontSize="20"
                            Foreground="{StaticResource CabText}" Margin="11,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="[LIVE]" FontFamily="{StaticResource CabMono}"
                            FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabCrimson}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}"
                            VerticalAlignment="Center" Margin="11,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Style="{StaticResource TactPill}" Background="{StaticResource CabCrimson}"
                                Visibility="{Binding HasArmedSlots, Converter={StaticResource BoolVis}}"
                                HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource TactPillText}" Text="PAYLOAD ARMED" Foreground="{StaticResource CabGold}" />
                        </Border>
                        <Border Style="{StaticResource TactPill}" Background="{StaticResource CabAmberDark}"
                                Visibility="{Binding RankedBadgeVisible, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource TactPillText}" Text="{Binding RankedBadgeText}" Foreground="{StaticResource CabAmber}" />
                        </Border>
                        <TextBlock Text="{Binding DndLabel}" FontFamily="{StaticResource CabMono}"
                            FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabGold}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource CabHairline}" BorderThickness="1" CornerRadius="12"
                                    Padding="12" Background="{StaticResource CabSurface2}">
                                <TextBlock Text="{Binding SessionElapsed}" FontFamily="{StaticResource PopXBold}"
                                    FontSize="42" Foreground="{StaticResource CabText}"
                                    HorizontalAlignment="Center" />
                            </Border>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding PauseLabel}" Style="{StaticResource ArcadeOutlineWhite}"
                                        Command="{Binding PauseCommand}" Margin="0,0,5,0" FontSize="12" />
                                <Button Grid.Column="1" Content="⟳ REINICIAR" Style="{StaticResource ArcadeOutlineRed}"
                                        Command="{Binding RestartTimerCommand}" Margin="5,0,0,0" FontSize="12" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <CheckBox Content="MODO RANKED" IsChecked="{Binding RankedMode}"
                                          Style="{StaticResource TactCheck}" />
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,6,12">
                                    <TextBlock Text="SLOTS" FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextMut}" />
                                    <TextBlock Text="{Binding StatSlots}" FontFamily="{StaticResource PopBold}" FontSize="16" Foreground="{StaticResource CabText}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,12">
                                    <TextBlock Text="DELAY" FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextMut}" />
                                    <TextBlock Text="{Binding StatDelay}" FontFamily="{StaticResource PopBold}" FontSize="16" Foreground="{StaticResource CabAmber}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="RAM" FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextMut}" />
                                    <TextBlock Text="{Binding StatRam}" FontFamily="{StaticResource PopBold}" FontSize="16" Foreground="{StaticResource CabGold}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="GATE" FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextMut}" />
                                    <TextBlock Text="{Binding SelectedLoadoutTag}" FontFamily="{StaticResource PopBold}" FontSize="16" Foreground="{StaticResource CabCrimson}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding StatusLine}" FontSize="13" Foreground="{StaticResource CabTextDim}"
                                TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="36" />
                            <CheckBox Content="MINIMIZAR AL LANZAR" IsChecked="{Binding MinimizeOnLaunch}" Style="{StaticResource TactCheck}" Margin="0,10,0,0" />
                            <CheckBox Content="CPU HIGH-PRIORITY" IsChecked="{Binding HighPriority}" Style="{StaticResource TactCheck}" Margin="0,9,0,0" />
                            <TextBlock Text="Marca ⚡ HIGH en el acceso que quieres priorizar. Si ninguno, se priorizan todos." FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextMut}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <CheckBox Content="AUTO-KILL AL CERRAR" IsChecked="{Binding AutoKillTree}" Style="{StaticResource TactCheck}" Margin="0,9,0,0" />

                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding Loadouts.Count, Converter={StaticResource NotZeroVisConv}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DIRECTIVAS" FontFamily="{StaticResource PopBlack}" FontSize="14"
                                               Foreground="{StaticResource CabText}" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource CabSurface}" BorderBrush="{StaticResource CabHairline}"
                                            BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                                            Visibility="{Binding Directives.Count, Converter={StaticResource NotZeroVisConv}}">
                                        <TextBlock Text="{Binding Directives.Count, StringFormat={}{0:00}}" FontFamily="{StaticResource CabMono}"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource CabAmber}" />
                                    </Border>
                                    <Button Content="EDITAR" Style="{StaticResource ArcadeGhostBtn}" Padding="8,3" FontSize="10"
                                            Click="Directives_Click" Margin="8,0,0,0" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Directives}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CabSurface2}" BorderBrush="{StaticResource CabHairline}"
                                                    BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource PopXBold}" FontSize="13"
                                                               Foreground="{Binding AccentHex, Converter={StaticResource HexBrushConv}}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="{StaticResource CabText}"
                                                               Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="SIN DIRECTIVAS · pulsa EDITAR para añadir." FontFamily="{StaticResource CabMono}"
                                           FontSize="10" Foreground="{StaticResource CabTextMut}" Margin="0,2,0,0"
                                           Visibility="{Binding Directives.Count, Converter={StaticResource ZeroToVisConv}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Button Content="■  CERRAR TODO" Style="{StaticResource ArcadeStopBtn}"
                                Command="{Binding StopCommand}" FontSize="15" Padding="20,12" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Grid Grid.Row="2" Margin="28,14,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SysMemText}" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabTextDim}" />
                <TextBlock Text="   ·   " FontFamily="{StaticResource CabMono}" FontSize="11" Foreground="{StaticResource CabHairline}" />
                <TextBlock Text="{Binding WatchText}" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabGold}" />
                <TextBlock Text="   ·   " FontFamily="{StaticResource CabMono}" FontSize="11" Foreground="{StaticResource CabHairline}" />
                <TextBlock Text="{Binding SessionStateLabel}" FontFamily="{StaticResource CabMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CabText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource CabSurface2}" BorderBrush="{StaticResource CabHairline}"
                        BorderThickness="1" CornerRadius="10" Padding="9,5">
                    <Viewbox Stretch="Uniform" Height="20">
                        <Polyline x:Name="SparkLine" Width="150" Height="18" Points="{Binding SparkPoints}"
                                  Stroke="{StaticResource CabCrimson}" StrokeThickness="2" Fill="Transparent" />
                    </Viewbox>
                </Border>
                <TextBlock FontFamily="{StaticResource CabMono}" FontSize="10" Foreground="{StaticResource CabTextDim}"
                           Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="Ver / editar perfil activo" MouseLeftButtonDown="FooterTag_OpenProfile">
                    <Run Text="v" /><Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedLoadoutTag, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>